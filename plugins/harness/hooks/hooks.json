{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v harness >/dev/null 2>&1 && harness boot || true",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v harness >/dev/null 2>&1 && harness remember --auto || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v harness >/dev/null 2>&1 && harness remember --auto || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
